<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>{{ title }}</title>
<style>
body {
  font-family: system-ui;
  margin: 24px;
}

h1 {
  font-size: 18px;
  margin-bottom: 16px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

@media (max-width: 1100px) {
  .grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 700px) {
  .grid { grid-template-columns: 1fr; }
}

.card {
  border: 1px solid #eee;
  border-radius: 12px;
  padding: 10px;
}

img {
  width: 100%;
  height: auto;
  border-radius: 10px;
  border: 1px solid #eee;
}

.cap {
  margin-top: 8px;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
}
</style>
</head>
<body>
<h1>{{ title }}</h1>
<div class="grid">
{% for t in tiles %}
<div class="card">
  <img src="{{ t.uri }}" alt="{{ t.algo }}"/>
  <div class="cap">{{ t.algo }}</div>
</div>
{% endfor %}
</div>
</body>
</html>
